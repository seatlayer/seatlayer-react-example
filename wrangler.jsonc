{
  // This example on Cloudflare Workers static assets.
  // Build first (npm run build), then deploy with: npx wrangler deploy
  // That deploys your own copy under the name below, with no custom domain.
  // The "hosted" environment is the SeatLayer copy on
  // examples-react.seatlayer.io; you do not need it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seatlayer-react-example",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "hosted": {
      "name": "seatlayer-examples-react",
      "routes": [{ "pattern": "examples-react.seatlayer.io", "custom_domain": true }]
    }
  }
}
