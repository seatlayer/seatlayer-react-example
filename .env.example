# Event key: the top of the event's page in the dashboard. It is not the pk_ key.
VITE_SEATLAYER_EVENT_KEY=ev_replace_me

# Publishable key: Dashboard → Developer. It is safe in browser code.
# Never put a secret sk_ key in a front end bundle.
VITE_SEATLAYER_PUBLIC_KEY=pk_test_replace_me

# Optional. Two more event keys for the multiple events route. Each one falls
# back to VITE_SEATLAYER_EVENT_KEY when it is not set.
VITE_SEATLAYER_EVENT_KEY_2=
VITE_SEATLAYER_EVENT_KEY_3=

# Optional. A published season key for the season tickets route.
VITE_SEATLAYER_SEASON_KEY=

# Optional. The currency your event is priced in, for showing prices before a
# hold (ISO 4217, for example EUR). Defaults to USD.
VITE_SEATLAYER_CURRENCY=
